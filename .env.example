COMMENTATOR_HOST=127.0.0.1
COMMENTATOR_PORT=8000
COMMENTATOR_DB_PATH=var/commentator.sqlite3

# rotate: delete expired/old generations; permanent: never delete automatically.
COMMENTATOR_LOG_RETENTION=rotate
COMMENTATOR_LOG_DIR=var/log
COMMENTATOR_LOG_RETENTION_DAYS=30
COMMENTATOR_LOG_MAX_BYTES=10485760
COMMENTATOR_LOG_BACKUP_COUNT=5

# Set only the provider keys that will be used. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

