{
  "name": "@commentator/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "generate:api": "openapi-typescript openapi.json -o src/generated/api.ts",
    "check:api": "openapi-typescript openapi.json -o src/generated/api.ts --check",
    "check": "npm run check:api && tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "6.4.6"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "openapi-typescript": "7.13.0"
  }
}
